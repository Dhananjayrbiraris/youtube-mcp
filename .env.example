# ==============================================================================
# YouTube Studio & Channel Analytics MCP - Environment Configuration
# ==============================================================================

# 1. Google OAuth 2.0 Credentials (From Google Cloud Console Desktop App)
YOUTUBE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_client_secret_here

# 2. OAuth Refresh Token (Automatically filled after running 'uv run run_auth.py')
# Or paste your existing refresh token here if you already have one.
YOUTUBE_REFRESH_TOKEN=

# 3. Optional: Direct YouTube Data API Key (if you wish to use API key for public queries)
# YOUTUBE_API_KEY=
